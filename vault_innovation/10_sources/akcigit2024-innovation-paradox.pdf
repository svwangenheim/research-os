" /\u003e"}}}}}],"Page Title":[{"uid":"0a40ad74-0261-412e-881b-823c101a537a","componentName":"ArticleTitleBar","dataSource":"{E7DA88D2-46FA-4F8A-9AFD-D3E69CEED8A9}","params":{"GridParameters":"col-12","DynamicPlaceholderId":"29339277","FieldNames":"Default"},"fields":{"data":{"datasource":{"title":{"value":"F\u0026D Magazine","jsonValue":{"value":"F\u0026D Magazine"}},"titlebarLogo":{"value":"","jsonValue":{"value":{}}},"titlebarLogoLink":{"value":"\u003clink text=\"\" anchor=\"\" linktype=\"internal\" class=\"\" title=\"\" target=\"_blank\" querystring=\"\" id=\"{048827E7-7118-42D2-BB02-4D152B64B19D}\" /\u003e","jsonValue":{"value":{"text":"","anchor":"","linktype":"internal","class":"","title":"","target":"_blank","querystring":"","id":"{048827E7-7118-42D2-BB02-4D152B64B19D}","href":"/en/publications/fandd"}}}}}}}],"Content":[{"uid":"e44ec3c9-3427-42fd-b0ce-cce3c9673fa0","componentName":"FanddArticleFullWidth","dataSource":"","params":{"GridParameters":"col-12","DynamicPlaceholderId":"20995735","FieldNames":"Default"},"fields":{"data":{"speecifyConfiguration":{"speechifyAPIURL":{"jsonValue":{"value":"/Assets/IMF/js/speechifyapi.min.js"}},"speechifyEnabled":{"jsonValue":{"value":true}},"speechifyLanguageConfiguration":{"jsonValue":{"value":"'en': 'John',\r\n'ar': 'Fatima',\r\n'es': 'Javier',\r\n'fr': 'Louise',\r\n'ja': 'Sakura',\r\n'ru': 'Ivan',\r\n'zh': 'Yarong',\r\n'pt': 'Benicio',"}},"allowedLanguages":{"jsonValue":{"value":"en,ar,es,fr,ja,ru,zh,pt"}},"trackPlayClicks":{"jsonValue":{"value":true}},"trackPausedClicks":{"jsonValue":{"value":false}},"trackResumeClicks":{"jsonValue":{"value":false}},"trackSkippedForwardClicks":{"jsonValue":{"value":false}},"trackSkippedBackwardClicks":{"jsonValue":{"value":false}}},"CS0639617Workaround":{"id":"A3CB4949DA1F4AE3A0199B6915263A52"}}},"placeholders":{"ArticleTop-20995735":[{"uid":"420675c7-e32a-4717-b016-8cfb13e89c11","componentName":"LanguagePicker","dataSource":"","params":{"GridParameters":"col-12","DynamicPlaceholderId":"50423886","FieldNames":"Default"}}],"Article-20995735":[{"uid":"e3def17a-9244-483d-b2bf-396b130be452","componentName":"ArticleReadingTime","dataSource":"","params":{"GridParameters":"col-12","DynamicPlaceholderId":"37672863","FieldNames":"Default"}},{"uid":"e6bdf324-dd50-4a3a-95bd-93263563da5c","componentName":"DownloadPDF","dataSource":"","params":{"GridParameters":"col-12","DynamicPlaceholderId":"47116500","FieldNames":"Default"}},{"uid":"d51393c6-aed3-4f27-b688-0106da957eb7","componentName":"Chunk","dataSource":"{30F8ADC9-33F1-4DA1-BF9C-0BD0E8D2D861}","params":{"GridParameters":"col-12","DynamicPlaceholderId":"55255161","FieldNames":"Default"},"fields":{"Title":{"value":"Chunk"},"Content":{"value":"\u003c!-- BEGIN INTRO TEXT --\u003e\n\u003cp class=\"intro-text\"\u003eIncreased R\u0026amp;D spending isn\u0026rsquo;t necessarily boosting US productivity as industrial giants focus on defending their turf\u003c/p\u003e\n\u003cdiv class=\"container custom-container\"\u003e\n\u003cdiv id=\"speechify-root\"\u003e\u0026nbsp;\u003c/div\u003e\n\u003c/div\u003e\n\u003c!-- END INTRO TEXT --\u003e"},"EmbargoEnd":{"value":"0001-01-01T00:00:00Z"},"EmbargoHide":{"value":false},"EmbargoStart":{"value":"0001-01-01T00:00:00Z"}}},{"uid":"884dba07-9ebe-48ee-aef0-6feabfdaf13b","componentName":"Chunk","dataSource":"{A893F3EF-D80D-4421-A0BD-74019FFB50B9}","params":{"GridParameters":"col-12","DynamicPlaceholderId":"20778664","FieldNames":"Default"},"fields":{"Title":{"value":"Intro Body Chunk"},"Content":{"value":"\u003cp\u003eInvesting more in research and development, we\u0026rsquo;ve long assumed, is a surefire way to spur innovation, increase productivity, and fuel job creation and economic growth. And yet, as the US dramatically expanded R\u0026amp;D spending over the past four decades, the opposite happened. Innovation, productivity gains, and economic expansion slowed. What went wrong?\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eReal-world data show that there\u0026rsquo;s more nuance to encouraging innovation than simply throwing money at it. Giant enterprises came to dominate vast swaths of the American economy, crowding out more innovative smaller businesses and start-ups. Across sectors, the biggest players prioritized strategic moves to defend their businesses rather than seeking genuine innovation, and as a result the economy missed potential growth opportunities, according to recent research.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eSuch findings suggest it\u0026rsquo;s time to rethink and better focus the American approach to ensuring innovation and economic growth. Policymakers need to encourage not only R\u0026amp;D but also the more effective allocation of resources. A look at how US innovation changed over the past few decades suggests how they can do that.\u0026nbsp;\u003c/p\u003e\n\u003ch6\u003e\u003cstrong\u003eDouble-edged sword\u003c/strong\u003e\u003c/h6\u003e\n\u003cp\u003eIn the 1980s, total US R\u0026amp;D investment represented 2.2 percent of GDP. Today, that figure is 3.4 percent, according to the National Science Foundation (see Chart 1). Private R\u0026amp;D spending by businesses more than doubled, to 2.5 percent of GDP from 1.1 percent.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://www.imf.org/-/media/images/imf/fandd/charts/2024/09/akcigit-chart1-v3.jpg?w=950\" style=\"width:950px;\" alt=\"Baby Burst\" class=\"Image-enlarge\" data-featherlight=\"https://www.imf.org/-/media/images/imf/fandd/charts/2024/09/akcigit-chart1-v3.jpg\" /\u003e\u003c/p\u003e\n\u003cp\u003eBased on conventional economic models, that kind of increase in R\u0026amp;D spending should have led to accelerated economic growth rather than the slowdown that actually occurred. Productivity growth between 1960 and 1985 averaged 1.3 percent. Over the subsequent three and a half decades, gains in productivity fell below that average, except for a brief uptick in the early 2000s, and annual growth has generally been declining.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eTo understand how conventional analysis so badly missed the mark, we need to move away from aggregate data and examine the structure and distribution of R\u0026amp;D spending in the US using high-quality microdata on businesses, inventors, and innovations.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eThe Census Bureau\u0026rsquo;s Nathan Goldschlag and I conducted extensive studies to understand the factors behind the productivity paradox. We found a significant shift in the US landscape of innovation. Over the past two decades, the proportion of the population involved in patent production nearly doubled, while productivity growth fell by half.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eThe explanation may lie in how R\u0026amp;D spending is allocated. In earlier research, \u003ca href=\"https://www.journals.uchicago.edu/doi/full/10.1086/697901\" target=\"_blank\" rel=\"noopener noreferrer\"\u003eHarvard\u0026rsquo;s William Kerr and I found that small businesses are more innovative relative to their size\u003c/a\u003e, suggesting they use R\u0026amp;D resources more efficiently. As companies grow and dominate their markets, they often shift their focus from innovation to protecting their market position.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eIn a \u003ca href=\"https://onlinelibrary.wiley.com/doi/full/10.3982/ECTA18338\" target=\"_blank\" rel=\"noopener noreferrer\"\u003emore recent study\u003c/a\u003e, Salome Baslandze, Francesca Lotti, and I showed using Italian data that larger enterprises tend to innovate less and instead engage in activities that limit competition. One such activity is hiring local politicians. As businesses climb the ranks among the largest 20 players in their industry, they hire more politicians, while their patent production declines. This highlights what we call a leadership paradox, where leading companies plow resources into maintaining dominance rather than fostering innovation.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eThis shift in focus among big businesses might be a pivotal factor in the US productivity slowdown. As dominant players prioritize strategic moves over genuine innovation, the economy as a whole is almost certainly missing out on potential growth opportunities. Understanding this dynamic is crucial for policymakers seeking to effectively encourage true innovation and drive economic growth.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eOver the past two decades, there has been a notable reallocation of innovative resources toward large, established companies, \u003ca href=\"https://www.nber.org/papers/w31085\" target=\"_blank\" rel=\"noopener noreferrer\"\u003eGoldschlag and I documented in 2022\u003c/a\u003e. At the beginning of this century, roughly 48 percent of American inventors worked for these big incumbent companies\u0026mdash;those that are more than 20 years old and employ more than 1,000 workers. By 2015, that figure had surged to 58 percent, marking a significant shift in where the nation\u0026rsquo;s innovative talent is concentrated.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eAt first glance, this shift might not seem problematic. After all, the big companies might have the resources to support extensive R\u0026amp;D. However, research shows a concerning trend: inventors that move to large firms become less innovative compared with inventors that move to young firms.\u0026nbsp;\u003c/p\u003e\n\u003ch6\u003eInnovation-stifling hiring\u003c/h6\u003e\n\u003cp\u003eA specific practice identified in our research is innovation-stifling hiring. This occurs when big, established enterprises hire key employees from younger competitors, often by offering higher salaries. However, instead of using these new employees to drive innovation, the big businesses may place them in roles that do not fully leverage their skills. As a result, these individuals become less innovative, and the overall innovative capacity of the economy suffers.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eAfter 2000, there was a notable increase in the wage premium offered by established companies, compared with salaries paid by younger businesses. The pay differential widened by 20 percent, prompting many innovators to switch jobs and join larger, well-established companies (see Chart 2). However, these inventors\u0026rsquo; innovativeness dropped by 6 percent compared with that of their peers who joined younger employers.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://www.imf.org/-/media/images/imf/fandd/charts/2024/09/akcigit-chart2-v3.jpg?w=950\" style=\"width:950px;\" alt=\"Baby Burst\" class=\"Image-enlarge\" data-featherlight=\"https://www.imf.org/-/media/images/imf/fandd/charts/2024/09/akcigit-chart2-v3.jpg\" /\u003e\u003c/p\u003e\n\u003cp\u003eOne interpretation of this practice could be that it serves as a strategic move by large enterprises to neutralize potential competitive threats. By hiring away top talent from rivals, these companies not only weaken their competitors but also prevent these individuals from contributing to potentially disruptive innovations elsewhere. This strategy may benefit the hiring business in the short term, but it poses a long-term risk to the economy\u0026rsquo;s overall innovation and growth.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eThis suggests that while the US has been increasing overall R\u0026amp;D spending relative to GDP, the shift of inventive talent toward large, old businesses has not led to the expected boost in productivity. These industrial incumbents often prioritize maintaining their market dominance over pushing the boundaries of innovation. This defensive stance means that even though more resources are being funneled into R\u0026amp;D, they are not being used as effectively as they could be in smaller, more agile companies.\u0026nbsp;\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eConsequently, the US economy is not benefiting from growth in productivity spurred by R\u0026amp;D spending. This underscores the importance of not just the amount of R\u0026amp;D investment but also where and how it is allocated. To truly harness the power of innovation, policies and incentives need to shift to encourage more dynamic, risk-taking behavior, particularly among smaller enterprises and start-ups. This could lead to the kind of productivity gains the US needs.\u003c/p\u003e\n\u003ch6\u003ePerverse incentives\u0026nbsp;\u003c/h6\u003e\n\u003cp\u003eThe debate around the role of industrial policy in the US has intensified, with a renewed emphasis on strong industrial strategies. Reflecting on past experiences can offer valuable insights. The Federal Reserve\u0026rsquo;s \u003ca href=\"https://www.aeaweb.org/articles?id=10.1257/mac.20180449\" target=\"_blank\" rel=\"noopener noreferrer\"\u003eSina Ates and I examined market competition trends in the US\u003c/a\u003e over the past several decades. Since the early 1980s, there\u0026rsquo;s been a noticeable increase in market concentration and a decline in business dynamism, we found.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eThis period aligns with the 1981 introduction of the R\u0026amp;D tax credit, a component of President Ronald Reagan\u0026rsquo;s sweeping Economic Recovery Tax Act. The credit was intended to encourage businesses to invest in research and development. Minnesota was the first state to adopt a similar state-level R\u0026amp;D tax credit, in 1982, and many other states followed, expecting to promote innovation and economic growth.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eWhich companies are most likely to take advantage of the R\u0026amp;D tax credit? Our research with Goldschlag shows that large businesses are much more likely to benefit than smaller ones. The policy\u0026mdash;perhaps unintentionally\u0026mdash;favors big companies, encouraging them to dominate in R\u0026amp;D spending.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eWhen we combine this observation with the innovation-stifling hiring practices of large businesses, a pattern emerges. Can policy be linked to more of these practices? It seems the answer is yes. Our research provides direct evidence that businesses actively claiming R\u0026amp;D tax credits are more likely to engage in such practices. These enterprises often offer higher salaries to inventors, and the inventors become less innovative after joining. This suggests that innovation subsidies, while intended to encourage research and development, might inadvertently reduce overall innovation by creating different incentives for market leaders compared with smaller, younger rivals.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eThe evidence suggests that while the US is investing more in R\u0026amp;D, the concentration of resources among large businesses has led to diminishing returns in terms of productivity growth. This outcome challenges the assumption that simply expanding R\u0026amp;D spending will automatically lead to economic growth. Instead, it highlights the need for a more nuanced approach to industrial policy\u0026mdash;one that not only incentivizes R\u0026amp;D but also encourages the effective reallocation of resources.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eTo foster a more dynamic and innovative economy, the US needs to design policies that support not just large incumbents but also smaller businesses and start-ups, which often have a greater capacity for disruptive innovation. This could include targeted tax credits for small businesses, grants for early-stage innovation, and policies that encourage competition and reduce barriers to entry for new players.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eWhile the US has significantly increased R\u0026amp;D spending over a sustained period, the benefits haven\u0026rsquo;t been evenly distributed, contributing to the slowdown in productivity growth. Policymakers need to reconsider the use of traditional industrial policies, which may have led to reduced competition and slower productivity gains. It\u0026rsquo;s not just about the total amount spent on R\u0026amp;D but also how it\u0026rsquo;s allocated. By creating a more inclusive innovation ecosystem, the US can better tap its innovative talent, boosting economic growth and securing future prosperity.\u003c/p\u003e"},"EmbargoEnd":{"value":"0001-01-01T00:00:00Z"},"EmbargoHide":{"value":false},"EmbargoStart":{"value":"0001-01-01T00:00:00Z"}}},{"uid":"23256e0c-fd1b-4630-9af1-e394065cd900","componentName":"ArticleAuthorList","dataSource":"","params":{"GridParameters":"col-12","DynamicPlaceholderId":"19873419","FieldNames":"Default"},"fields":{"data":{"item":{"authors":{"targetItems":[{"name":"UFUK AKCIGIT","authorImage":{"jsonValue":{"value":{"src":"https://www.imf.org/-/media/images/imf/fandd/authors/ufuk-akcigit.jpg?h=300\u0026iar=0\u0026w=300","alt":"UFUK AKCIGIT","width":"300","height":"300"}}},"authorShortBio":{"jsonValue":{"value":"\u003cp\u003e\u003cstrong\u003eUFUK AKCIGIT\u003c/strong\u003e is the Arnold C. Harberger Professor of Economics at the University of Chicago, a research associate with the National Bureau of Economic Research, and a research affiliate at the Centre for Economic Policy Research.\u003c/p\u003e"}}}]}}}}},{"uid":"927f6525-49ca-41a2-874e-3afe042a81ff","componentName":"Chunk","dataSource":"{098EFD16-8923-4E37-88FA-AD60C7409FE1}","params":{"GridParameters":"col-12","DynamicPlaceholderId":"40257644","FieldNames":"Default"},"fields":{"Content":{"value":"\u003c!-- BEGIN FOOTNOTE --\u003e\n\u003cp class=\"footnote\"\u003eOpinions expressed in articles and other materials are those of the authors; they do not necessarily reflect IMF policy.\u003c/p\u003e\n\u003c!-- END FOOTNOTE --\u003e"},"Title":{"value":"Article Disclaimer"},"EmbargoEnd":{"value":"0001-01-01T00:00:00Z"},"EmbargoHide":{"value":false},"EmbargoStart":{"value":"0001-01-01T00:00:00Z"}}},{"uid":"de3843f0-0486-4a5f-9bc3-a0781aa3c919","componentName":"Chunk","dataSource":"{1B6F590A-4BA8-4031-97C5-A3FC9AF60A24}","params":{"GridParameters":"col-12","DynamicPlaceholderId":"17704951","FieldNames":"Default"},"fields":{"Title":{"value":"Content After Disclaimer"},"Content":{"value":"\u003c!-- BEGIN REFERENCES --\u003e\n\u003cdiv class=\"disclaimer padded-vertical-20\"\u003e\n\u003ch6\u003eReferences:\u003c/h6\u003e\n\u003cp\u003eAkcigit, Ufuk, and Sina Ates. 2021 \u0026ldquo;Ten Facts on Declining Business Dynamism and Lessons from Endogenous Growth Theory.\u0026rdquo; American Economic Journal: Macroeconomics 13 (1): 257\u0026ndash;98.\u003cbr /\u003e\n\u003cbr /\u003e\nAkcigit, Ufuk, Salome Baslandze, and Francesca Lotti. 2023. \u0026ldquo;Connecting to Power: Political Connections, Innovation, and Firm Dynamics.\u0026rdquo; Econometrica 91 (2): 529\u0026ndash;64. \u003cbr /\u003e\n\u003cbr /\u003e\nAkcigit, Ufuk, and Nathan Goldschlag. 2022. \u0026ldquo;Where Have All the \u0026lsquo;Creative Talents\u0026rsquo; Gone? Employment Dynamics of US Inventors.\u0026rdquo; NBER Working Paper 31085, National Bureau of Economic Research, Cambridge, MA. \u003cbr /\u003e\n\u003cbr /\u003e\nAkcigit, Ufuk, and Nathan Goldschlag. 2024. \u0026ldquo;Understanding the Innovation Puzzle: Firm Size, Inventors, and Industrial Policy.\u0026rdquo; University of Chicago Working Paper, Chicago, IL. \u003cbr /\u003e\n\u003cbr /\u003e\nAkcigit, Ufuk, and William Kerr. 2018. \u0026ldquo;Growth through Heterogeneous Innovations.\u0026rdquo; Journal of Political Economy 126 (4): 1374\u0026ndash;443.\u003cbr /\u003e\n\u003cbr /\u003e\nThe Census Bureau has ensured appropriate use of confidential data and reviewed for compliance with disclosure-avoidance rules (Project 7083300: CBDRB-FY24-CES007-01).\n\u003c/p\u003e\n\u003c/div\u003e\n\u003c!-- END REFERENCES --\u003e"},"EmbargoEnd":{"value":"0001-01-01T00:00:00Z"},"EmbargoHide":{"value":false},"EmbargoStart":{"value":"0001-01-01T00:00:00Z"}}}],"Aside-20995735":[{"uid":"34119723-049c-4a55-85b6-682e9e1f04aa","componentName":"AsideLinksFullWidth","dataSource":"{94CBF529-CF3D-4FA2-A7EB-07DBF7080C5B}","params":{"Style":"{8BEAF422-B6EE-47B6-B854-49420C99B1C7}","GridParameters":"col-12","DynamicPlaceholderId":"36190884","FieldNames":"Default"},"fields":{"errors":[{"message":"Unable to find field 'embargoStart' on item '/sitecore/content/IMF/IMF/Home/Publications/fandd/issues/2024/09/the-innovation-paradox-ufuk-akcigit/Data/Aside Links Full Width/related 1 [9655028AB3A44D798FBFB8D4EFF5D069]'","locations":[{"line":26,"column":11}],"path":["datasource","children","results",0,"embargoStart"]},{"message":"Unable to find field 'embargoEnd' on item '/sitecore/content/IMF/IMF/Home/Publications/fandd/issues/2024/09/the-innovation-paradox-ufuk-akcigit/Data/Aside Links Full Width/related 1 [9655028AB3A44D798FBFB8D4EFF5D069]'","locations":[{"line":30,"column":11}],"path":["datasource","children","results",0,"embargoEnd"]},{"message":"Unable to find field 'embargoHide' on item '/sitecore/content/IMF/IMF/Home/Publications/fandd/issues/2024/09/the-innovation-paradox-ufuk-akcigit/Data/Aside Links Full Width/related 1 [9655028AB3A44D798FBFB8D4EFF5D069]'","locations":[{"line":34,"column":11}],"path":["datasource","children","results",0,"embargoHide"]},{"message":"Unable to find field 'embargoStart' on item '/sitecore/content/IMF/IMF/Home/Publications/fandd/issues/2024/09/the-innovation-paradox-ufuk-akcigit/Data/Aside Links Full Width/Link With Text Item 2 [64F1955263EE46C8840AE57FC65E607F]'","locations":[{"line":26,"column":11}],"path":["datasource","children","results",1,"embargoStart"]},{"message":"Unable to find field 'embargoEnd' on item '/sitecore/content/IMF/IMF/Home/Publications/fandd/issues/2024/09/the-innovation-paradox-ufuk-akcigit/Data/Aside Links Full Width/Link With Text Item 2 [64F1955263EE46C8840AE57FC65E607F]'","locations":[{"line":30,"column":11}],"path":["datasource","children","results",1,"embargoEnd"]},{"message":"Unable to find field 'embargoHide' on item '/sitecore/content/IMF/IMF/Home/Publications/fandd/issues/2024/09/the-innovation-paradox-ufuk-akcigit/Data/Aside Links Full Width/Link With Text Item 2 [64F1955263EE46C8840AE57FC65E607F]'","locations":[{"line":34,"column":11}],"path":["datasource","children","results",1,"embargoHide"]},{"message":"Unable to find field 'embargoStart' on item '/sitecore/content/IMF/IMF/Home/Publications/fandd/issues/2024/09/the-innovation-paradox-ufuk-akcigit/Data/Aside Links Full Width/related 2 [8EE2511F51304891A84B6BC23681C225]'","locations":[{"line":26,"column":11}],"path":["datasource","children","results",2,"embargoStart"]},{"message":"Unable to find field 'embargoEnd' on item '/sitecore/content/IMF/IMF/Home/Publications/fandd/issues/2024/09/the-innovation-paradox-ufuk-akcigit/Data/Aside Links Full Width/related 2 [8EE2511F51304891A84B6BC23681C225]'","locations":[{"line":30,"column":11}],"path":["datasource","children","results",2,"embargoEnd"]},{"message":"Unable to find field 'embargoHide' on item '/sitecore/content/IMF/IMF/Home/Publications/fandd/issues/2024/09/the-innovation-paradox-ufuk-akcigit/Data/Aside Links Full Width/related 2 [8EE2511F51304891A84B6BC23681C225]'","locations":[{"line":34,"column":11}],"path":["datasource","children","results",2,"embargoHide"]},{"message":"Unable to find field 'embargoStart' on item '/sitecore/content/IMF/IMF/Home/Publications/fandd/issues/2024/09/the-innovation-paradox-ufuk-akcigit/Data/Aside Links Full Width/Link With Text Item 3 [1EAB5C74B0934B66B1CF08EE723F438E]'","locations":[{"line":26,"column":11}],"path":["datasource","children","results",3,"embargoStart"]},{"message":"Unable to find field 'embargoEnd' on item '/sitecore/content/IMF/IMF/Home/Publications/fandd/issues/2024/09/the-innovation-paradox-ufuk-akcigit/Data/Aside Links Full Width/Link With Text Item 3 [1EAB5C74B0934B66B1CF08EE723F438E]'","locations":[{"line":30,"column":11}],"path":["datasource","children","results",3,"embargoEnd"]},{"message":"Unable to find field 'embargoHide' on item '/sitecore/content/IMF/IMF/Home/Publications/fandd/issues/2024/09/the-innov